# SCSS SATYA — Environment Configuration Example

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Application Metadata
PROJECT_NAME="SCSS SATYA"
DOCTRINE="The tool screens. The expert decides."

# Security & Constraints
MAX_FILE_SIZE_BYTES=52428800
MAX_IMAGE_PIXELS=100000000

# Error Level Analysis Parameters
ELA_JPEG_QUALITY=90
ELA_AMPLIFICATION_SCALE=15

# Frontend Client Configuration (Optional — defaults to /api)
# Set when frontend is served independently from backend
VITE_API_URL=http://127.0.0.1:8000/api
